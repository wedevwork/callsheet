{
  "version": 1,
  "limits": {
    "max_sessions_per_client": 12,
    "max_case_ms": 900000,
    "max_client_ms": 5400000
  },
  "clients": [
    {
      "id": "codex",
      "executable": "<absolute-path-to-codex>",
      "expected_version": "codex-cli 0.156.1",
      "version_argv": [
        "--version"
      ],
      "help_argv": [
        "exec",
        "--help"
      ],
      "driver": "model",
      "model": "<model>",
      "decoder": "codex-jsonl",
      "decoder_fixture": "codex-jsonl/synthetic",
      "session": {
        "argv": [
          "exec",
          "--json",
          "--skip-git-repo-check",
          "-C",
          "{workspace}",
          "-m",
          "<model>",
          "-c",
          "mcp_servers.probe.command=\"{server}\"",
          "-c",
          "mcp_servers.probe.args=[\"serve\",\"--case-file\",\"{workspace}/case.json\",\"--events\",\"{workspace}/server-events.jsonl\"]",
          "{prompt}"
        ]
      },
      "config": {
        "default": {
          "path": "probe-config.toml",
          "content": "[mcp_servers.probe]\ncommand = \"{server}\"\nargs = [\"serve\", \"--case-file\", \"{case_file}\", \"--events\", \"{events}\"]\n"
        },
        "raised": {
          "path": "probe-config.toml",
          "content": "[mcp_servers.probe]\ncommand = \"{server}\"\nargs = [\"serve\", \"--case-file\", \"{case_file}\", \"--events\", \"{events}\"]\ntool_timeout_sec = <raised-timeout-seconds>\n",
          "argv": [
            "-c",
            "mcp_servers.probe.tool_timeout_sec=<raised-timeout-seconds>"
          ]
        }
      },
      "override": {
        "setting": "mcp_servers.<server>.tool_timeout_sec",
        "value": "<raised-timeout-seconds>",
        "explanation": "candidate per-server tool timeout key, applied with -c; a candidate until this phase proves it",
        "evidence": [
          "tests/testdata/cli-help/codex-help.txt"
        ]
      },
      "phases": {
        "default": {},
        "override": {
          "delay_ms": 720000
        },
        "progress": {},
        "absolute": {
          "delay_ms": 840000
        }
      }
    }
  ]
}
