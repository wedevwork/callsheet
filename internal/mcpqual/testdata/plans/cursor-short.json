{
  "version": 1,
  "limits": {
    "max_sessions_per_client": 3,
    "max_case_ms": 120000,
    "max_client_ms": 360000
  },
  "clients": [
    {
      "id": "cursor",
      "executable": "<absolute-path-to-cursor-agent>",
      "expected_version": "<exact-cli-version>",
      "version_argv": [
        "--version"
      ],
      "help_argv": [
        "--help"
      ],
      "driver": "model",
      "model": "<model>",
      "decoder": "cursor-jsonl",
      "decoder_fixture": "cursor-jsonl/synthetic",
      "session": {
        "argv": [
          "-p",
          "{prompt}",
          "--output-format",
          "stream-json",
          "--model",
          "<model>",
          "--workspace",
          "{workspace}",
          "--trust"
        ]
      },
      "config": {
        "default": {
          "path": ".cursor/mcp.json",
          "content": "{\"mcpServers\":{\"probe\":{\"command\":\"{server}\",\"args\":[\"serve\",\"--case-file\",\"{case_file}\",\"--events\",\"{events}\"]}}}",
          "prerequisite": "Trust only the generated workspace; capture runs mcp enable probe there and verifies workspace-only file changes before the model session; never --approve-mcps."
        }
      },
      "phases": {
        "default": {
          "delays_ms": [
            15000
          ]
        }
      }
    }
  ]
}
